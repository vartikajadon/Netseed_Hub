{
  "version": 2,
  "regions": ["bom1"],
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 15,
        "excludeFiles": "{tests/**,*.db,seed_data.py,docs/**,**/__pycache__/**,scratch/**,*.md}"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
