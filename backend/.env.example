APP_NAME=Netlink Trainee Platform API
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=sqlite:///./netlink_dev.db

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256

# Netlink Bhopal / Mandideep Office Geofence Configuration
NETLINK_OFFICE_LAT=23.111861
NETLINK_OFFICE_LON=77.515744
GEOFENCE_RADIUS_METERS=100.0
GPS_MAX_ACCURACY_METERS=50.0

# Biometric & Face Recognition Settings (InsightFace / ArcFace / Anti-Spoofing)
FACE_MATCH_THRESHOLD=0.60
FACE_DUPLICATE_THRESHOLD=0.82
LIVENESS_MIN_SCORE=0.70
MIN_FACE_QUALITY_SCORE=0.60
MIN_SAMPLES_FOR_ENROLLMENT=3
MAX_SAMPLES_FOR_ENROLLMENT=5
