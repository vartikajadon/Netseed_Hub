VITE_APP_NAME=Netlink Trainee Platform

# Local Development: target local FastAPI server (proxied cleanly by Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Vercel Production: setting VITE_API_BASE_URL=/api/v1 routes all API calls
# through the same-origin reverse proxy configured in frontend/vercel.json.
# This eliminates cross-origin browser OPTIONS preflight latency on every request!
# VITE_API_BASE_URL=/api/v1

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
